{
  "name": "engimedit",
  "version": "1.0.0",
  "private": true,
  "description": "EngimEdit: editor video nel browser per principianti. Taglia, dividi, unisci ed esporta in MP4. I video restano sul computer.",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "node build.mjs && eslint -c eslint.config.cjs dist/app.js",
    "test": "node --test tests/engine.test.js",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "media": "bash scripts/make-test-media.sh"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "eslint": "9.14.0",
    "playwright": "1.63.0"
  },
  "engines": { "node": ">=20" }
}
